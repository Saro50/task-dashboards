{
  "name": "task-dashboards",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"],
    "overrides": {
      "@myby/log-shared": "file:/Users/finlaywu/MyWork/short_url_demo/results/deepseek-v4-flash/myrole/log-system/packages/shared"
    }
  },
  "scripts": {
    "dev:server": "pnpm --filter @task-dashboards/server dev",
    "dev:web": "pnpm --filter @task-dashboards/web dev",
    "build:server": "pnpm --filter @task-dashboards/server build",
    "build:web": "pnpm --filter @task-dashboards/web build",
    "prisma:migrate": "pnpm --filter @task-dashboards/server prisma:migrate",
    "prisma:generate": "pnpm --filter @task-dashboards/server prisma:generate",
    "prisma:studio": "pnpm --filter @task-dashboards/server prisma:studio",
    "test": "pnpm --filter @task-dashboards/server test && pnpm --filter @task-dashboards/web test",
    "test:integration": "pnpm --filter @task-dashboards/server exec vitest run src/__tests__/opencode-v2.integration.test.ts --reporter=verbose"
  }
}
