{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "task-helper": {
      "mode": "primary",
      "prompt": "{file:./roles/task_helper.md}",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "write": "deny"
      }
    }
  }
}
