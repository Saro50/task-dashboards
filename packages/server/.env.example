# ============================
# 数据库
# ============================
DATABASE_URL="postgresql://user:password@localhost:5432/taskboard_db"

# ============================
# opencode engine
# ============================
OPENCODE_BASE_URL=http://localhost:4096

# ============================
# Mock Engine（测试用）
# ============================
# 启用 mock engine，跳过真实 opencode SDK 调用。
# 适用于没有运行 opencode engine 的环境下测试完整的任务链执行流程。
MOCK_ENGINE=false

# worktree 创建延迟 (ms)，默认 500
MOCK_WT_DELAY=500

# session 创建延迟 (ms)，默认 300
MOCK_SESSION_DELAY=300

# 每批步骤 AI 处理延迟 (ms)，默认 2000
MOCK_TASK_DELAY=2000

# 随机步骤失败概率 (0-1)，0 = 不失败，默认 0
MOCK_FAILURE_RATE=0

# 每个 session 内，在 N 个成功步骤后开始失败（0 = 不限），默认 0
MOCK_FAIL_AFTER=0
